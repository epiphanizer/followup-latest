{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "module": "commonjs",
    "target": "es2018",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "files": ["setup-jest.ts"],
  "include": ["src/**/*.ts"],
  "exclude": ["e2e/**/*.ts", "dist/**"]
}
