{
  "name": "followup-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "./main.js",
  "scripts": {
    "ng": "ng",
    "build": "npm run env -s && ng build --aot --prod=true",
    "postinstall": "npm run build",
    "serve": "npm run env -s && ng serve --aot  --proxy-config proxy.conf.js",
    "serve:sw": "npm run build -s && npx http-server ./dist -p 4200",
    "lint": "ng lint && stylelint \"src/**/*.scss\" --syntax scss && htmlhint \"src\" --config .htmlhintrc",
    "test": "npm run env -s && ng test",
    "test:ci": "npm run env -s && npm run lint -s && ng test --code-coverage --watch=false",
    "e2e": "npm run env -s && ng e2e",
    "translations:extract": "ngx-translate-extract --input ./src --output ./src/translations/template.json --format=json --clean --sort --marker extract",
    "docs": "hads ./docs -o",
    "env": "ngx-scripts env npm_package_version",
    "prettier": "prettier --write \"./{src,e2e}/**/*.{ts,js,html,scss}\"",
    "prettier:check": "prettier --list-different \"./{src,e2e}/**/*.{ts,js,html,scss}\"",
    "generate": "ng generate"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "^0.803.17",
    "@angular/animations": "^8.1.1",
    "@angular/cli": "~8.3.17",
    "@angular/common": "^8.2.13",
    "@angular/compiler": "^8.2.13",
    "@angular/compiler-cli": "^8.2.13",
    "@angular/core": "^8.2.13",
    "@angular/forms": "^8.2.13",
    "@angular/http": "^7.2.3",
    "@angular/language-service": "^8.2.13",
    "@angular/platform-browser": "^8.2.13",
    "@angular/platform-browser-dynamic": "^8.2.13",
    "@angular/router": "^8.2.13",
    "@angular/service-worker": "^8.2.13",
    "@auth0/angular-jwt": "^4.0.0",
    "@ionic-native/date-picker": "^5.12.0",
    "@ionic/angular": "^4.0.0",
    "@ngx-rocket/scripts": "^4.0.0",
    "@ngx-translate/core": "^11.0.1",
    "angular-animations": "0.0.10",
    "angular-super-validator": "^2.0.0",
    "bn-ng-idle": "^1.0.1",
    "core-js": "^3.3.6",
    "ionic-logging-service": "^7.0.0",
    "lodash": "^4.17.14",
    "moment": "^2.24.0",
    "rxjs": "^6.4.0",
    "rxjs-compat": "^6.5.2",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@biesbjerg/ngx-translate-extract": "^4.2.0",
    "@types/jasmine": "^3.4.4",
    "@types/jasminewd2": "^2.0.8",
    "@types/lodash": "^4.14.144",
    "@types/node": "^12.12.3",
    "codelyzer": "^5.2.0",
    "hads": "^2.0.1",
    "htmlhint": "^0.11.0",
    "https-proxy-agent": "^3.0.1",
    "husky": "^3.0.9",
    "jasmine-core": "~3.5.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~4.4.1",
    "karma-chrome-launcher": "^3.1.0",
    "karma-cli": "~2.0.0",
    "karma-coverage-istanbul-reporter": "^2.1.0",
    "karma-jasmine": "^2.0.1",
    "karma-jasmine-html-reporter": "^1.4.0",
    "karma-junit-reporter": "^2.0.1",
    "prettier": "^1.16.3",
    "pretty-quick": "^2.0.0",
    "protractor": "~5.4.0",
    "stylelint": "~11.1.1",
    "stylelint-config-prettier": "^6.0.0",
    "stylelint-config-recommended-scss": "~4.0.0",
    "stylelint-config-standard": "~19.0.0",
    "stylelint-scss": "~3.12.0",
    "ts-node": "~8.4.1",
    "tslint": "~5.20.0",
    "tslint-config-prettier": "^1.14.0",
    "typescript": "3.5"
  },
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.scss",
        "options": {
          "singleQuote": false
        }
      }
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  }
}
