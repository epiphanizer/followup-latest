{
  "name": "followup-care",
  "version": "4.0.4",
  "private": true,
  "engines": {
    "node": "^18 || ^20 || ^24",
    "npm": ">=9 <12"
  },
  "main": "./main.js",
  "scripts": {
    "check:node": "node ./scripts/check-node-version.js",
    "ng": "ng",
    "build": "npm run check:node -s && npm run env -s && ng build --configuration production",
    "build alpha": "npm run check:node -s && npm run env -s && ng build --configuration=alpha",
    "postinstall": "echo skip postinstall build",
    "serve": "npm run check:node -s && npm run env -s && ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.js",
    "serve:sw": "npm run build -s && npx http-server ./dist -p 4200",
    "lint:ts": "ng lint",
    "lint": "npm run lint:ts -s",
    "test": "npm run check:node -s && npm run env -s && jest",
    "test:ci": "npm run check:node -s && npm run env -s && npm run lint -s && jest --runInBand --coverage",
    "docs": "npx http-server ./docs -o",
    "env": "ngx-scripts env npm_package_version APP_INSIGHTS_CONNECTION_STRING APPLICATIONINSIGHTS_CONNECTION_STRING FOLLOWUP_API_KEY_AUTH API_KEY_AUTH",
    "prettier": "prettier --write \"./{src,e2e}/**/*.{ts,js,html,scss}\"",
    "prettier:check": "prettier --list-different \"./{src,e2e}/**/*.{ts,js,html,scss}\"",
    "generate": "ng generate"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "^21.2.16",
    "@angular/animations": "^21.2.17",
    "@angular/cli": "~21.2.16",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/compiler-cli": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/language-service": "^21.2.17",
    "@angular/localize": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@angular/service-worker": "^21.2.17",
    "@auth0/angular-jwt": "^5.2.0",
    "@ionic/angular": "^8.3.0",
    "@microsoft/applicationinsights-web": "3.4.2",
    "@ngx-rocket/scripts": "^4.0.0",
    "@ngx-translate/core": "^16.0.4",
    "@types/file-saver": "^2.0.1",
    "angular-animations": "0.0.10",
    "angular-super-validator": "^2.0.0",
    "angular-uuid": "0.0.4",
    "bn-ng-idle": "^1.0.1",
    "compressorjs": "^1.0.6",
    "core-js": "^3.3.6",
    "file-saver": "^2.0.2",
    "jw-paginate": "^1.0.4",
    "lodash": "^4.17.14",
    "lodash.debounce": "^4.0.8",
    "moment": "^2.24.0",
    "ngx-image-compress": "^18.0.0",
    "ngx-mask": "^18.0.0",
    "ngx-toastr": "^19.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.0.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.4.0",
    "@angular-eslint/eslint-plugin": "^21.4.0",
    "@angular-eslint/eslint-plugin-template": "^21.4.0",
    "@angular-eslint/schematics": "^21.4.0",
    "@angular-eslint/template-parser": "^21.4.0",
    "@biesbjerg/ngx-translate-extract": "^7.0.4",
    "@testing-library/angular": "^10.11.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@types/jasmine": "^3.8.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "4.14.149",
    "@types/node": "^12.12.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@typescript-eslint/types": "^7.18.0",
    "@typescript-eslint/utils": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.11.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "http-server": "^14.1.1",
    "https-proxy-agent": "^3.0.1",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^16.1.5",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "~8.4.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "websocket-driver": "0.7.4",
    "formidable": "1.2.6",
    "multer": "1.4.4-lts.1"
  },
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.scss",
        "options": {
          "singleQuote": false
        }
      }
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  }
}
