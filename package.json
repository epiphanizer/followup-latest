{
  "name": "followup-care",
  "version": "4.0.0",
  "private": true,
  "engines": {
    "node": "^18 || ^20 || ^24",
    "npm": ">=9 <12"
  },
  "main": "./main.js",
  "scripts": {
    "check:node": "node ./scripts/check-node-version.js",
    "ng": "ng",
    "build": "npm run check:node -s && npm run env -s && ng build --prod=true",
    "build alpha": "npm run check:node -s && npm run env -s && ng build --configuration=alpha",
    "postinstall": "echo skip postinstall build",
    "serve": "npm run check:node -s && npm run env -s && ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.js",
    "serve:sw": "npm run build -s && npx http-server ./dist -p 4200",
    "lint:ts": "ng lint",
    "lint": "npm run lint:ts -s && stylelint \"src/**/*.scss\" --syntax scss && htmlhint \"src\" --config .htmlhintrc",
    "test": "npm run check:node -s && npm run env -s && jest",
    "test:ci": "npm run check:node -s && npm run env -s && npm run lint -s && jest --runInBand --coverage",
    "test:legacy": "npm run check:node -s && npm run env -s && ng test",
    "e2e": "npm run check:node -s && npm run env -s && ng e2e",
    "docs": "hads ./docs -o",
    "env": "ngx-scripts env npm_package_version APP_INSIGHTS_CONNECTION_STRING APPLICATIONINSIGHTS_CONNECTION_STRING",
    "prettier": "prettier --write \"./{src,e2e}/**/*.{ts,js,html,scss}\"",
    "prettier:check": "prettier --list-different \"./{src,e2e}/**/*.{ts,js,html,scss}\"",
    "generate": "ng generate"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "^12.2.18",
    "@angular/animations": "^12.2.17",
    "@angular/cli": "~12.2.18",
    "@angular/common": "^12.2.17",
    "@angular/compiler": "^12.2.17",
    "@angular/compiler-cli": "^12.2.17",
    "@angular/core": "^12.2.17",
    "@angular/forms": "^12.2.17",
    "@angular/language-service": "^12.2.17",
    "@angular/platform-browser": "^12.2.17",
    "@angular/platform-browser-dynamic": "^12.2.17",
    "@angular/router": "^12.2.17",
    "@angular/service-worker": "^12.2.17",
    "@auth0/angular-jwt": "5.0.2",
    "@microsoft/applicationinsights-web": "3.4.1",
    "@ionic-native/date-picker": "^5.12.0",
    "@ionic/angular": "5.9.4",
    "@ionic/cli": "^6.12.1",
    "@ngx-rocket/scripts": "^4.0.0",
    "@ngx-translate/core": "^11.0.1",
    "@types/file-saver": "^2.0.1",
    "angular-animations": "0.0.10",
    "angular-super-validator": "^2.0.0",
    "angular-uuid": "0.0.4",
    "bn-ng-idle": "^1.0.1",
    "compressorjs": "^1.0.6",
    "core-js": "^3.3.6",
    "file-saver": "^2.0.2",
    "ionic": "^5.4.16",
    "ionic-logging-service": "12.0.0",
    "jw-paginate": "^1.0.4",
    "lodash": "^4.17.14",
    "lodash.debounce": "^4.0.8",
    "moment": "^2.24.0",
    "ngx-image-compress": "11.0.3",
    "ngx-mask": "11.1.4",
    "ngx-toastr": "13.2.1",
    "rxjs": "^6.5.5",
    "rxjs-compat": "^6.5.2",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.8"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^1.2.0",
    "@angular-eslint/eslint-plugin": "^1.2.0",
    "@angular-eslint/eslint-plugin-template": "^1.2.0",
    "@angular-eslint/schematics": "^1.2.0",
    "@angular-eslint/template-parser": "^1.2.0",
    "@biesbjerg/ngx-translate-extract": "^4.2.0",
    "@testing-library/angular": "^10.11.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@types/jasmine": "^3.8.0",
    "@types/jasminewd2": "^2.0.8",
    "@types/lodash": "4.14.149",
    "@types/jest": "^27.5.2",
    "@types/node": "^12.12.3",
    "codelyzer": "^6.0.1",
    "hads": "^2.0.1",
    "htmlhint": "^0.11.0",
    "https-proxy-agent": "^3.0.1",
    "husky": "^3.0.9",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^27.5.1",
    "jest-preset-angular": "^11.1.1",
    "jest-environment-jsdom": "^27.5.1",
    "jasmine-core": "~3.8.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "^3.1.0",
    "karma-cli": "~2.0.0",
    "karma-coverage-istanbul-reporter": "^2.1.0",
    "karma-jasmine": "^2.0.1",
    "karma-jasmine-html-reporter": "^1.4.0",
    "karma-junit-reporter": "^2.0.1",
    "eslint": "^7.32.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^30.7.13",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "prettier": "^1.16.3",
    "pretty-quick": "^2.0.0",
    "protractor": "~7.0.0",
    "stylelint": "~11.1.1",
    "stylelint-config-prettier": "^6.0.0",
    "stylelint-config-recommended-scss": "~4.0.0",
    "stylelint-config-standard": "~19.0.0",
    "stylelint-scss": "~3.12.0",
    "ts-jest": "^27.1.5",
    "ts-node": "~8.4.1",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "tslint": "~6.1.3",
    "tslint-config-prettier": "^1.14.0",
    "typescript": "4.3.5"
  },
  "overrides": {
    "websocket-driver": "0.7.4",
    "formidable": "1.2.6",
    "multer": "1.4.4-lts.1"
  },
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.scss",
        "options": {
          "singleQuote": false
        }
      }
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  }
}
