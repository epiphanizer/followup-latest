{
  "name": "followup-care",
  "version": "3.9.0",
  "private": true,
  "main": "./main.js",
  "scripts": {
    "ng": "ng",
    "build": "npm run env -s && ng build --aot --prod=true",
    "build alpha": "npm run env -s && ng build --aot --configuration=alpha",
    "postinstall": "echo skip postinstall build",
    "serve": "npm run env -s && ng serve --aot --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.js",
    "serve:sw": "npm run build -s && npx http-server ./dist -p 4200",
    "lint": "ng lint && stylelint \"src/**/*.scss\" --syntax scss && htmlhint \"src\" --config .htmlhintrc",
    "test": "npm run env -s && ng test",
    "test:ci": "npm run env -s && npm run lint -s && ng test --code-coverage --watch=false",
    "e2e": "npm run env -s && ng e2e",
    "docs": "hads ./docs -o",
    "env": "ngx-scripts env npm_package_version",
    "prettier": "prettier --write \"./{src,e2e}/**/*.{ts,js,html,scss}\"",
    "prettier:check": "prettier --list-different \"./{src,e2e}/**/*.{ts,js,html,scss}\"",
    "generate": "ng generate"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "^0.1100.1",
    "@angular/animations": "^11.0.0",
    "@angular/cli": "~11.0.1",
    "@angular/common": "^11.0.0",
    "@angular/compiler": "^11.0.0",
    "@angular/compiler-cli": "^11.0.0",
    "@angular/core": "^11.0.0",
    "@angular/forms": "^11.0.0",
    "@angular/language-service": "^11.0.0",
    "@angular/platform-browser": "^11.0.0",
    "@angular/platform-browser-dynamic": "^11.0.0",
    "@angular/router": "^11.0.0",
    "@angular/service-worker": "^11.0.0",
    "@auth0/angular-jwt": "5.0.2",
    "@ionic-native/date-picker": "^5.12.0",
    "@ionic/angular": "5.8.0",
    "@ionic/cli": "^6.12.1",
    "@ngx-rocket/scripts": "^4.0.0",
    "@ngx-translate/core": "^11.0.1",
    "@types/file-saver": "^2.0.1",
    "angular-animations": "0.0.10",
    "angular-super-validator": "^2.0.0",
    "angular-uuid": "0.0.4",
    "bn-ng-idle": "^1.0.1",
    "compressorjs": "^1.0.6",
    "core-js": "^3.3.6",
    "file-saver": "^2.0.2",
    "ionic": "^5.4.16",
    "ionic-logging-service": "12.0.0",
    "jw-paginate": "^1.0.4",
    "lodash": "^4.17.14",
    "lodash.debounce": "^4.0.8",
    "moment": "^2.24.0",
    "ngx-image-compress": "11.0.3",
    "ngx-mask": "11.1.4",
    "ngx-toastr": "13.2.1",
    "react-scripts": "^5.0.1",
    "rxjs": "^6.5.5",
    "rxjs-compat": "^6.5.2",
    "tslib": "^2.0.0",
    "zone.js": "~0.10.3"
  },
  "devDependencies": {
    "@biesbjerg/ngx-translate-extract": "^4.2.0",
    "@types/jasmine": "^3.4.4",
    "@types/jasminewd2": "^2.0.8",
    "@types/lodash": "^4.14.144",
    "@types/node": "^12.12.3",
    "codelyzer": "^6.0.1",
    "hads": "^2.0.1",
    "htmlhint": "^0.11.0",
    "https-proxy-agent": "^3.0.1",
    "husky": "^3.0.9",
    "jasmine-core": "~3.5.0",
    "jasmine-spec-reporter": "~4.2.1",
    "karma": "~5.1.1",
    "karma-chrome-launcher": "^3.1.0",
    "karma-cli": "~2.0.0",
    "karma-coverage-istanbul-reporter": "^2.1.0",
    "karma-jasmine": "^2.0.1",
    "karma-jasmine-html-reporter": "^1.4.0",
    "karma-junit-reporter": "^2.0.1",
    "prettier": "^1.16.3",
    "pretty-quick": "^2.0.0",
    "protractor": "~7.0.0",
    "stylelint": "~11.1.1",
    "stylelint-config-prettier": "^6.0.0",
    "stylelint-config-recommended-scss": "~4.0.0",
    "stylelint-config-standard": "~19.0.0",
    "stylelint-scss": "~3.12.0",
    "ts-node": "~8.4.1",
    "tslint": "~6.1.3",
    "tslint-config-prettier": "^1.14.0",
    "typescript": "4.0.5"
  },
  "prettier": {
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.scss",
        "options": {
          "singleQuote": false
        }
      }
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  }
}
